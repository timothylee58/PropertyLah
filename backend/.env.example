QWEN_API_KEY=your-dashscope-api-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# must match serverUrlSecret (or the HMAC credential secret) on the Vapi assistant
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret
# set to false only for local curl testing
VAPI_VERIFY_WEBHOOK=true
# enable only if you attached a credential to the custom-LLM model.url in Vapi
VAPI_VERIFY_LLM_ENDPOINT=false

OPENCLAW_API_KEY=your-openclaw-api-key
OPENCLAW_BASE_URL=https://api.openclaw.dev

# Staff dashboard (/api/*, /leads, /calls) — a shared key every operator/the
# frontend sends back. Generate with e.g. `openssl rand -hex 32`.
DASHBOARD_API_KEY=your-dashboard-api-key
# set to false only for local dev without a key configured
DASHBOARD_REQUIRE_AUTH=true

# Comma-separated browser origins allowed to call this API. No wildcard.
FRONTEND_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WEBHOOK_PER_MINUTE=60
RATE_LIMIT_DASHBOARD_PER_MINUTE=120

# Cal.com booking backend
CAL_API_KEY=cal_live_xxx
CAL_BASE_URL=https://api.cal.com/v2
CAL_EVENT_TYPE_ID=123456
CAL_TIMEZONE=Asia/Kuala_Lumpur
CAL_SLOT_DAYS_AHEAD=7
CAL_SLOTS_TO_OFFER=3
CAL_FALLBACK_ATTENDEE_EMAIL=leads@your-agency.com
CAL_SLOTS_API_VERSION=2024-09-04
CAL_BOOKINGS_API_VERSION=2024-08-13
