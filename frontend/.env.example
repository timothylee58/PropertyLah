# KeyNest AI — Frontend environment
# Copy to .env.local and fill in for live mode.

# Frontend-safe
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=

# Dashboard auth (middleware.ts) — every /api/* route except /api/health
# requires this as an X-Api-Key header or Authorization: Bearer token.
# NEXT_PUBLIC_DASHBOARD_API_KEY must be set to the SAME value so the browser
# can send it back; generate with e.g. `openssl rand -hex 32`. This is a
# stopgap against opportunistic scraping/abuse, not real per-operator auth —
# it ships in the client bundle like any other NEXT_PUBLIC_ var.
DASHBOARD_API_KEY=
NEXT_PUBLIC_DASHBOARD_API_KEY=
# set to false only for local dev without a key configured
DASHBOARD_REQUIRE_AUTH=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DASHBOARD_PER_MINUTE=120
RATE_LIMIT_AGENT_PER_MINUTE=30

# Server-only: Qwen (OpenAI-compatible endpoint)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Server-only: Hermes agent/orchestration (optional)
HERMES_API_URL=
HERMES_API_KEY=

# Server-only: Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: Google Calendar (optional)
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only: WhatsApp / voice provider tokens (optional)
WHATSAPP_BUSINESS_TOKEN=
VAPI_WEBHOOK_SECRET=

# Server-only: Telegram bot (optional)
# Set @BotFather token and a random webhook secret. Webhook URL: /api/telegram/webhook?secret=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
