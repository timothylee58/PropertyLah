# KeyNest AI — Frontend environment
# Copy to .env.local and fill in for live mode.

# Frontend-safe
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=

# Server-only: Qwen (OpenAI-compatible endpoint)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Server-only: Hermes agent/orchestration (optional)
HERMES_API_URL=
HERMES_API_KEY=

# Server-only: Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: Google Calendar (optional)
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only: WhatsApp / voice provider tokens (optional)
WHATSAPP_BUSINESS_TOKEN=
VAPI_WEBHOOK_SECRET=

# Server-only: ElevenLabs (optional)
# TTS: set API key and at least one voice ID. Use "eleven_multilingual_v2" for English + Malay.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=                        # default fallback
ELEVENLABS_VOICE_ID_EN=                     # English voice
ELEVENLABS_VOICE_ID_MS=                     # Bahasa Malaysia voice
# Outbound calls (optional): provider can be "twilio" or "exotel"
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_PROVIDER=twilio

# Server-only: Telegram bot (optional)
# Set @BotFather token and a random webhook secret. Webhook URL: /api/telegram/webhook?secret=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
