# Frontend environment for KeyNest AI
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: enable Qwen in demo mode for AI-generated WhatsApp replies
# Do not commit the real key. Set QWEN_API_KEY in .env.local (and Vercel).
QWEN_BASE_URL=https://api-inference.modelscope.ai/v1
QWEN_MODEL=Qwen-Ambassador/Qwen3.8-Max
QWEN_API_KEY=your_modelscope_key_here
